\@writefile{toc}{\contentsline {section}{\numberline {S1}Full Coverage$\times $Stride Heatmaps}{1}{section.1.1}\protected@file@percent }
\newlabel{sec:sup_heatmaps}{{S1}{1}{Full Coverage$\times $Stride Heatmaps}{section.1.1}{}}
\newlabel{sec:sup_heatmaps@cref}{{[section][1][]S1}{[1][1][]1}}
\@writefile{lof}{\contentsline {figure}{\numberline {S1}{\ignorespaces R3D-18 (CNN-3D) coverage$\times $stride accuracy (\%) across 8 datasets. Sharp cliff at stride 4$\to $8 on AUTSL (75\%$\to $27\%) and similar cliff on FineGym are consistent with the high temporal demand of fine-grained actions. EPIC-Kitchens and UCF-101 retain high accuracy even at sparse sampling.\relax }}{2}{figure.caption.2}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:heatmap_r3d}{{S1}{2}{R3D-18 (CNN-3D) coverage$\times $stride accuracy (\%) across 8 datasets. Sharp cliff at stride 4$\to $8 on AUTSL (75\%$\to $27\%) and similar cliff on FineGym are consistent with the high temporal demand of fine-grained actions. EPIC-Kitchens and UCF-101 retain high accuracy even at sparse sampling.\relax }{figure.caption.2}{}}
\newlabel{fig:heatmap_r3d@cref}{{[figure][1][]S1}{[1][1][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces MC3-18 (CNN-mix, channel-separated 3D) heatmaps. Similar pattern to R3D-18 but with slightly reduced \ \leavevmode {\color  {revblue}evidence loss} on low-TDS datasets (UCF-101, DriveAct). FineGym shows the same severe cliff pattern as AUTSL.\relax }}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:heatmap_mc3}{{S2}{2}{MC3-18 (CNN-mix, channel-separated 3D) heatmaps. Similar pattern to R3D-18 but with slightly reduced \revdel {aliasing}\ \rev {evidence loss} on low-TDS datasets (UCF-101, DriveAct). FineGym shows the same severe cliff pattern as AUTSL.\relax }{figure.caption.3}{}}
\newlabel{fig:heatmap_mc3@cref}{{[figure][2][]S2}{[1][1][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {S3}{\ignorespaces R2+1D-18 (separable spatiotemporal convolution) heatmaps. Higher base accuracy than R3D-18 on several datasets (SSv2: 42.6\% vs 37.1\%), but a similar \ \leavevmode {\color  {revblue}sampling-sensitivity} pattern.\relax }}{2}{figure.caption.4}\protected@file@percent }
\newlabel{fig:heatmap_r2p1d}{{S3}{2}{R2+1D-18 (separable spatiotemporal convolution) heatmaps. Higher base accuracy than R3D-18 on several datasets (SSv2: 42.6\% vs 37.1\%), but a similar \revdel {aliasing-sensitivity}\ \rev {sampling-sensitivity} pattern.\relax }{figure.caption.4}{}}
\newlabel{fig:heatmap_r2p1d@cref}{{[figure][3][]S3}{[1][1][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {S4}{\ignorespaces \leavevmode {\color  {revblue}SlowFast-R50 (dual-pathway) heatmaps. The AUTSL cliff occurs at stride 2$\to $4 (77\%$\to $41\%), one step earlier than for the other CNNs under the original fixed-budget protocol. This difference is consistent with SlowFast's larger frame budget but does not isolate its causal role. On FineGym, SlowFast achieves the highest base accuracy (78.2\%) but suffers the largest evidence loss (71.5pp at stride=16) under this protocol.}\relax }}{2}{figure.caption.5}\protected@file@percent }
\newlabel{fig:heatmap_slowfast}{{S4}{2}{\rev {SlowFast-R50 (dual-pathway) heatmaps. The AUTSL cliff occurs at stride 2$\to $4 (77\%$\to $41\%), one step earlier than for the other CNNs under the original fixed-budget protocol. This difference is consistent with SlowFast's larger frame budget but does not isolate its causal role. On FineGym, SlowFast achieves the highest base accuracy (78.2\%) but suffers the largest evidence loss (71.5pp at stride=16) under this protocol.}\relax }{figure.caption.5}{}}
\newlabel{fig:heatmap_slowfast@cref}{{[figure][4][]S4}{[1][1][]2}}
\@writefile{lof}{\contentsline {figure}{\numberline {S5}{\ignorespaces \leavevmode {\color  {revblue}TimeSformer (divided space--time attention) heatmaps. Accuracy is relatively flat across much of the original grid, with steeper degradation at the combined extreme of low coverage and high stride. FineGym drops 36.1pp at stride=16. These are descriptive fixed-budget curves; they do not identify the contribution of divided attention.}\relax }}{3}{figure.caption.6}\protected@file@percent }
\newlabel{fig:heatmap_timesformer}{{S5}{3}{\rev {TimeSformer (divided space--time attention) heatmaps. Accuracy is relatively flat across much of the original grid, with steeper degradation at the combined extreme of low coverage and high stride. FineGym drops 36.1pp at stride=16. These are descriptive fixed-budget curves; they do not identify the contribution of divided attention.}\relax }{figure.caption.6}{}}
\newlabel{fig:heatmap_timesformer@cref}{{[figure][5][]S5}{[1][1][]3}}
\@writefile{lof}{\contentsline {figure}{\numberline {S6}{\ignorespaces \leavevmode {\color  {revblue}ViViT (factorized attention) heatmaps. Despite being a Transformer, ViViT shows large fixed-budget drops (AUTSL: cliff at stride 2$\to $4, comparable to SlowFast); FineGym drops 55.2pp at stride=16. The comparison is observational and does not attribute this pattern to factorized temporal attention.}\relax }}{3}{figure.caption.7}\protected@file@percent }
\newlabel{fig:heatmap_vivit}{{S6}{3}{\rev {ViViT (factorized attention) heatmaps. Despite being a Transformer, ViViT shows large fixed-budget drops (AUTSL: cliff at stride 2$\to $4, comparable to SlowFast); FineGym drops 55.2pp at stride=16. The comparison is observational and does not attribute this pattern to factorized temporal attention.}\relax }{figure.caption.7}{}}
\newlabel{fig:heatmap_vivit@cref}{{[figure][6][]S6}{[1][1][]3}}
\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces \leavevmode {\color  {revblue}VideoMAE (masked autoencoder) heatmaps. Base accuracy is high on SSv2 (52.4\%), UCF-101 (95.4\%), and FineGym (78.0\%), while its original-protocol curve falls sharply on AUTSL (stride 4$\to $8) and FineGym (67.8pp at stride=16). This pattern cannot isolate the contribution of the MAE pretraining objective.}\relax }}{3}{figure.caption.8}\protected@file@percent }
\newlabel{fig:heatmap_videomae}{{S7}{3}{\rev {VideoMAE (masked autoencoder) heatmaps. Base accuracy is high on SSv2 (52.4\%), UCF-101 (95.4\%), and FineGym (78.0\%), while its original-protocol curve falls sharply on AUTSL (stride 4$\to $8) and FineGym (67.8pp at stride=16). This pattern cannot isolate the contribution of the MAE pretraining objective.}\relax }{figure.caption.8}{}}
\newlabel{fig:heatmap_videomae@cref}{{[figure][7][]S7}{[1][1][]3}}
\@writefile{lof}{\contentsline {figure}{\numberline {S8}{\ignorespaces VideoMamba (SSM selective scan) heatmaps (all 8 datasets). \leavevmode {\color  {revblue}Sensitivity is low on five datasets and higher on FineGym (40.8pp), AUTSL (16.0pp), and SSv2 (14.1pp); these observational differences do not isolate the effect of the temporal module.}\relax }}{3}{figure.caption.9}\protected@file@percent }
\newlabel{fig:heatmap_videomamba}{{S8}{3}{VideoMamba (SSM selective scan) heatmaps (all 8 datasets). \revdel {On 5 of 8 datasets, VideoMamba shows a flat heatmap with minimal degradation across strides---the SSM recurrent state aggregates temporal context, providing natural robustness. FineGym (40.8pp), AUTSL (16.0pp), and SSv2 (14.1pp) are exceptions, revealing the limit of SSM temporal integration under high-frequency transitions.}\rev {Sensitivity is low on five datasets and higher on FineGym (40.8pp), AUTSL (16.0pp), and SSv2 (14.1pp); these observational differences do not isolate the effect of the temporal module.}\relax }{figure.caption.9}{}}
\newlabel{fig:heatmap_videomamba@cref}{{[figure][8][]S8}{[1][1][]3}}
\@writefile{toc}{\contentsline {section}{\numberline {S2}Levene Variance Inflation Analysis}{4}{section.1.2}\protected@file@percent }
\newlabel{sec:sup_levene}{{S2}{4}{Levene Variance Inflation Analysis}{section.1.2}{}}
\newlabel{sec:sup_levene@cref}{{[section][2][]S2}{[1][4][]4}}
\@writefile{lof}{\contentsline {figure}{\numberline {S9}{\ignorespaces Levene test: inter-class accuracy std at stride=1 vs.\ stride=16. Points above the dashed diagonal have higher variance under sparse sampling. Color encodes the variance ratio ($\sigma _{s16}/\sigma _{s1}$). \textbf  {Key finding}: 67\% of model-dataset pairs show significant variance inflation ($p<0.05$), with the largest increases in VideoMAE/HMDB-51 (2.0$\times $) and R3D-18/HMDB-51 (1.85$\times $). TimeSformer and VideoMamba show stable variance ($\approx $1.1$\times $).\relax }}{4}{figure.caption.10}\protected@file@percent }
\newlabel{fig:levene}{{S9}{4}{Levene test: inter-class accuracy std at stride=1 vs.\ stride=16. Points above the dashed diagonal have higher variance under sparse sampling. Color encodes the variance ratio ($\sigma _{s16}/\sigma _{s1}$). \textbf {Key finding}: 67\% of model-dataset pairs show significant variance inflation ($p<0.05$), with the largest increases in VideoMAE/HMDB-51 (2.0$\times $) and R3D-18/HMDB-51 (1.85$\times $). TimeSformer and VideoMamba show stable variance ($\approx $1.1$\times $).\relax }{figure.caption.10}{}}
\newlabel{fig:levene@cref}{{[figure][9][]S9}{[1][4][]4}}
\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Top-10 variance inflation cases (stride=1$\to $16, coverage=100\%). All rows significant at $p{<}0.05$.\relax }}{5}{table.caption.11}\protected@file@percent }
\newlabel{tab:levene_top}{{S1}{5}{Top-10 variance inflation cases (stride=1$\to $16, coverage=100\%). All rows significant at $p{<}0.05$.\relax }{table.caption.11}{}}
\newlabel{tab:levene_top@cref}{{[table][1][]S1}{[1][4][]5}}
