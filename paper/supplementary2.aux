\@writefile{toc}{\contentsline {title}{Supplementary Material:\unskip \ \ignorespaces  \leavevmode {\color  {revblue}Measuring Spatiotemporal Sampling Sensitivity in Video Action Recognition:\unskip \ \ignorespaces  A Cross-Architecture Analysis at Scale}}{1}{chapter.1}\protected@file@percent }
