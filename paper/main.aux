\@writefile{toc}{\contentsline {paragraph}{Attention type correlates with aliasing.}{6}{section*.14}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Left}: \textsc  {TDS}{} ranking---mean accuracy drop from stride=1 to 16 averaged over all 8 architectures ($n{=}8$). FineGym (55.9pp) and AUTSL (53.0pp) are co-equal highest-demand domains (order between them is leave-one-out sensitive; see supplementary material); UCF-101 (4.9pp) is appearance-dominated. Positions 3--8 are exactly stable under leave-one-architecture-out. \textbf  {Right}: Pearson correlation between optical-flow magnitude and per-class aliasing loss (8 datasets). AUTSL and DriveAct show the expected positive correlation; EPIC-Kitchens is near-zero (background camera motion confounds flow); FineGym shows the strongest correlation of any dataset but in the opposite direction ($r=-0.475$): discrete-event classes alias more than sustained-motion ones.\relax }}{7}{figure.caption.12}\protected@file@percent }
\newlabel{fig:tds_spectral}{{3}{7}{\textbf {Left}: \TDS {} ranking---mean accuracy drop from stride=1 to 16 averaged over all 8 architectures ($n{=}8$). FineGym (55.9pp) and AUTSL (53.0pp) are co-equal highest-demand domains (order between them is leave-one-out sensitive; see supplementary material); UCF-101 (4.9pp) is appearance-dominated. Positions 3--8 are exactly stable under leave-one-architecture-out. \textbf {Right}: Pearson correlation between optical-flow magnitude and per-class aliasing loss (8 datasets). AUTSL and DriveAct show the expected positive correlation; EPIC-Kitchens is near-zero (background camera motion confounds flow); FineGym shows the strongest correlation of any dataset but in the opposite direction ($r=-0.475$): discrete-event classes alias more than sustained-motion ones.\relax }{figure.caption.12}{}}
\newlabel{fig:tds_spectral@cref}{{[figure][3][]3}{[1][6][]7}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Spectral validation: Pearson $r$ between optical-flow magnitude and per-class aliasing loss. Flow alone partially explains temporal demand; camera-motion-heavy datasets (EPIC, UCF) show weak correlation.\relax }}{8}{table.caption.13}\protected@file@percent }
\newlabel{tab:spectral}{{2}{8}{Spectral validation: Pearson $r$ between optical-flow magnitude and per-class aliasing loss. Flow alone partially explains temporal demand; camera-motion-heavy datasets (EPIC, UCF) show weak correlation.\relax }{table.caption.13}{}}
\newlabel{tab:spectral@cref}{{[table][2][]2}{[1][6][]8}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Accuracy vs.\ stride (cov=100\%) for three representative datasets. \textbf  {AUTSL} (\textsc  {TDS}{}=53.0pp): TimeSformer and VideoMamba remain most stable; all other models cliff above stride=4. \textbf  {SSv2} (\textsc  {TDS}{}=27.6pp): clear two-tier separation between robust (TSF, VMamba) and fragile models. \textbf  {UCF-101} (\textsc  {TDS}{}=4.9pp): minimal sensitivity across all architectures. These three datasets span the full \textsc  {TDS}{} range.\relax }}{8}{figure.caption.15}\protected@file@percent }
\newlabel{fig:aliasing_curves}{{4}{8}{Accuracy vs.\ stride (cov=100\%) for three representative datasets. \textbf {AUTSL} (\TDS {}=53.0pp): TimeSformer and VideoMamba remain most stable; all other models cliff above stride=4. \textbf {SSv2} (\TDS {}=27.6pp): clear two-tier separation between robust (TSF, VMamba) and fragile models. \textbf {UCF-101} (\TDS {}=4.9pp): minimal sensitivity across all architectures. These three datasets span the full \TDS {} range.\relax }{figure.caption.15}{}}
\newlabel{fig:aliasing_curves@cref}{{[figure][4][]4}{[1][7][]8}}
